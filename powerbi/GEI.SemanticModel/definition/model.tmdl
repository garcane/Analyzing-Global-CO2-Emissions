model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	discourageImplicitMeasures
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

ref table dim_geography
ref table dim_energy_source
ref table fct_generation_by_source
ref table mart_country_energy_profile
ref table mart_renewable_growth
ref table mart_energy_transition

ref expression ExportsFolder

ref cultureInfo en-GB
