/// Annual date dimension for filtering generation by reporting year.
table dim_date
	lineageTag: 51a7700e-9323-4c74-a307-fdd818d63a86
	dataCategory: Time

	column Date
		dataType: dateTime
		isUnique
		isKey
		formatString: dd MMM yyyy
		lineageTag: 5c4303ca-a917-47c6-8133-fd440fd9bf3f
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		isUnique
		formatString: 0
		lineageTag: bfc1dcbf-247c-40e5-ba41-6ea39abae9c2
		summarizeBy: none
		sourceColumn: Year

	column 'Year Label'
		dataType: string
		lineageTag: fe3a8d10-3489-4732-b2db-76c4af6606bc
		summarizeBy: none
		sourceColumn: Year Label
		sortByColumn: Year

	partition dim_date = calculated
		mode: import
		source = VAR ReportingYears = DISTINCT ( UNION ( SELECTCOLUMNS ( fct_generation_by_source, "Year", fct_generation_by_source[year] ), SELECTCOLUMNS ( mart_country_energy_profile, "Year", mart_country_energy_profile[year] ), SELECTCOLUMNS ( mart_renewable_growth, "Year", mart_renewable_growth[year] ) ) ) RETURN ADDCOLUMNS ( FILTER ( ReportingYears, NOT ISBLANK ( [Year] ) ), "Date", DATE ( [Year], 1, 1 ), "Year Label", FORMAT ( [Year], "0" ) )

