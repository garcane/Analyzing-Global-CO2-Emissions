table mart_country_energy_profile

	measure 'Total Generation TWh' = CALCULATE ( SUM ( mart_country_energy_profile[total_generation_twh] ), mart_country_energy_profile[is_complete_year] = TRUE () )
		formatString: #,##0.0

	measure 'Renewables TWh' = CALCULATE ( SUM ( mart_country_energy_profile[renewables_twh] ), mart_country_energy_profile[is_complete_year] = TRUE () )
		formatString: #,##0.0

	measure 'Fossil TWh' = CALCULATE ( SUM ( mart_country_energy_profile[fossil_twh] ), mart_country_energy_profile[is_complete_year] = TRUE () )
		formatString: #,##0.0

	measure 'Nuclear TWh' = CALCULATE ( SUM ( mart_country_energy_profile[nuclear_twh] ), mart_country_energy_profile[is_complete_year] = TRUE () )
		formatString: #,##0.0

	measure 'Solar TWh' = CALCULATE ( SUM ( mart_country_energy_profile[solar_twh] ), mart_country_energy_profile[is_complete_year] = TRUE () )
		formatString: #,##0.0

	measure 'Wind TWh' = CALCULATE ( SUM ( mart_country_energy_profile[wind_twh] ), mart_country_energy_profile[is_complete_year] = TRUE () )
		formatString: #,##0.0

	measure 'Hydro TWh' = CALCULATE ( SUM ( mart_country_energy_profile[hydro_twh] ), mart_country_energy_profile[is_complete_year] = TRUE () )
		formatString: #,##0.0

	measure 'Coal TWh' = CALCULATE ( SUM ( mart_country_energy_profile[coal_twh] ), mart_country_energy_profile[is_complete_year] = TRUE () )
		formatString: #,##0.0

	measure 'Gas TWh' = CALCULATE ( SUM ( mart_country_energy_profile[gas_twh] ), mart_country_energy_profile[is_complete_year] = TRUE () )
		formatString: #,##0.0

	measure 'Renewable Share' = DIVIDE ( [Renewables TWh], [Total Generation TWh] )
		formatString: 0.0%

	measure 'Fossil Share' = DIVIDE ( [Fossil TWh], [Total Generation TWh] )
		formatString: 0.0%

	measure 'Coal Share' = DIVIDE ( [Coal TWh], [Total Generation TWh] )
		formatString: 0.0%

	measure 'Gas Share' = DIVIDE ( [Gas TWh], [Total Generation TWh] )
		formatString: 0.0%

	measure 'Wind + Solar Share' = DIVIDE ( [Wind TWh] + [Solar TWh], [Total Generation TWh] )
		formatString: 0.0%

	measure 'Generation per Capita kWh' = DIVIDE ( [Total Generation TWh] * 1000000000, SUM ( mart_country_energy_profile[population] ) )
		formatString: #,##0

	measure 'Renewables TWh PY' = VAR y = SELECTEDVALUE ( mart_country_energy_profile[year] ) RETURN CALCULATE ( [Renewables TWh], mart_country_energy_profile[year] = y - 1 )
		formatString: #,##0.0

	measure 'Renewables YoY TWh' = IF ( ISBLANK ( [Renewables TWh PY] ), BLANK (), [Renewables TWh] - [Renewables TWh PY] )
		formatString: #,##0.0

	measure 'Power Carbon Intensity gCO2e per kWh' = DIVIDE ( SUM ( mart_country_energy_profile[power_emissions_mtco2e] ), CALCULATE ( SUM ( mart_country_energy_profile[total_generation_twh] ), NOT ISBLANK ( mart_country_energy_profile[power_emissions_mtco2e] ) ) ) * 1000
		formatString: #,##0

	column geography_key
		dataType: string
