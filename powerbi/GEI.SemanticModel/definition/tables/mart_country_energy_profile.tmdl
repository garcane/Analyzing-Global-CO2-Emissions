	partition mart_country_energy_profile = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(ExportsFolder & "mart_country_energy_profile.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"geography_key", type text}, {"country_name", type text}, {"continent", type text}, {"year", Int64.Type}, {"total_generation_twh", type number}, {"total_generation_recomputed_twh", type number}, {"is_complete_year", type logical}, {"renewables_twh", type number}, {"fossil_twh", type number}, {"nuclear_twh", type number}, {"solar_twh", type number}, {"wind_twh", type number}, {"hydro_twh", type number}, {"bioenergy_twh", type number}, {"coal_twh", type number}, {"gas_twh", type number}, {"demand_twh", type number}, {"net_imports_twh", type number}, {"renewables_capacity_gw", type number}, {"power_emissions_mtco2e", type number}, {"power_carbon_intensity_gco2e_kwh", type number}, {"population", type number}, {"gdp_intl_dollar_2011", type number}, {"national_co2_mt", type number}, {"national_co2_per_capita_t", type number}, {"primary_energy_twh", type number}, {"has_economy_row", type logical}, {"renewable_share_pct", type number}, {"fossil_share_pct", type number}, {"nuclear_share_pct", type number}, {"wind_solar_share_pct", type number}, {"coal_share_pct", type number}, {"gas_share_pct", type number}, {"generation_per_capita_kwh", type number}}, "en-US")
				in
					Typed

