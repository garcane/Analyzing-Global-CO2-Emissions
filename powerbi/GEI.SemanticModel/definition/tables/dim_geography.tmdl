table dim_geography

	column geography_key
		dataType: string
		isHidden
		sourceColumn: geography_key
		summarizeBy: none

	column geography_name
		dataType: string
		sourceColumn: geography_name
		summarizeBy: none

	column entity_type
		dataType: string
		sourceColumn: entity_type
		summarizeBy: none

	column continent
		dataType: string
		sourceColumn: continent
		summarizeBy: none

	column is_country
		dataType: boolean
		sourceColumn: is_country
		summarizeBy: none

	partition dim_geography = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(ExportsFolder & "dim_geography.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"geography_key", type text}, {"geography_name", type text}, {"entity_type", type text}, {"continent", type text}, {"is_country", type logical}}, "en-US")
				in
					Typed
