		lineageTag: 6cf44b1f-5f83-494d-a8d8-aa57bb06b450
		summarizeBy: none
		sourceColumn: continent

	column year
		dataType: int64
		formatString: 0
		lineageTag: 320482af-9534-4fab-bf18-1798ade94751
		summarizeBy: none
		sourceColumn: year

	column series
		dataType: string
		lineageTag: e4893fdc-7f35-4d7e-bfa3-c666f2d6c082
		summarizeBy: none
		sourceColumn: series

	column generation_twh
		dataType: double
		formatString: #,##0.00
		lineageTag: 2f27aaad-ecaf-4392-b080-74d4cd5a21e2
		summarizeBy: none
		sourceColumn: generation_twh

	column capacity_gw
		dataType: double
		formatString: #,##0.00
		lineageTag: e3dd4ebf-7e15-4deb-97e6-9a2f4c622b6c
		summarizeBy: none
		sourceColumn: capacity_gw

	column yoy_change_twh
		dataType: double
		formatString: #,##0.00
		lineageTag: f50163da-aab9-419b-a8c4-7233482e8dd8
		summarizeBy: none
		sourceColumn: yoy_change_twh

	column yoy_change_pct
		dataType: double
		formatString: #,##0.00
		lineageTag: b75683d5-92f7-4e9e-a624-aad5264aaefb
		summarizeBy: none
		sourceColumn: yoy_change_pct

	column capacity_factor
		dataType: double
		formatString: #,##0.00
		lineageTag: 1f59c6ba-92fa-44bd-b0ae-ade5a9adeab5
		summarizeBy: none
		sourceColumn: capacity_factor

	partition mart_renewable_growth = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(ExportsFolder & "mart_renewable_growth.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"geography_key", type text}, {"country_name", type text}, {"continent", type text}, {"year", Int64.Type}, {"series", type text}, {"generation_twh", type number}, {"capacity_gw", type number}, {"yoy_change_twh", type number}, {"yoy_change_pct", type number}, {"capacity_factor", type number}}, "en-US")
				in
					Typed

