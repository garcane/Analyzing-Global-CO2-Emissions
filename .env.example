# Copy to .env and fill in. Never commit .env. Real secrets (API keys, passwords) never go in this file.

# --- Snowflake (used by ingestion/ and later dbt) ---
SNOWFLAKE_ACCOUNT=GWEPWIG-CA86069
# Authentication mode:
#   keypair         (default) service user + private key. The only mode for CI/automation.
#   externalbrowser interactive browser login for local development. Set SNOWFLAKE_USER to your own
#                   login name, leave SNOWFLAKE_PRIVATE_KEY_PATH empty, keep SNOWFLAKE_ROLE=GEI_LOADER
#                   (needs the optional grant in infra/snowflake_setup.sql section 7).
# Admin roles (ACCOUNTADMIN, SYSADMIN, ...) are refused by the loader in both modes.
SNOWFLAKE_AUTHENTICATOR=keypair
# keypair: the service user created by infra/snowflake_setup.sql. externalbrowser: your own login name.
SNOWFLAKE_USER=GEI_LOADER_SVC
# Path to the PKCS8 private key, stored OUTSIDE the repo (see docs/snowflake_setup.md).
SNOWFLAKE_PRIVATE_KEY_PATH=C:/Users/<you>/.snowflake/gei_loader.p8
# Only if the key is passphrase-protected.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=GEI_LOADER
SNOWFLAKE_WAREHOUSE=GEI_WH
# This project has its own databases, separate from any course/tutorial data in RAW / ANALYTICS.
GEI_RAW_DATABASE=GEI_RAW
GEI_ANALYTICS_DATABASE=GEI_ANALYTICS
# No password variable on purpose: routine jobs never use passwords or the ACCOUNTADMIN role.

# --- dbt (dbt/profiles.yml reads these; it signs in as its own service user) ---
DBT_SNOWFLAKE_USER=GEI_TRANSFORMER_SVC
DBT_SNOWFLAKE_ROLE=GEI_TRANSFORMER
DBT_SNOWFLAKE_PRIVATE_KEY_PATH=C:/Users/<you>/.snowflake/gei_transformer.p8
# Suffix for your personal dev schemas in GEI_ANALYTICS (dbt_<suffix>_staging, ...). Prod target ignores it.
DBT_DEV_SUFFIX=<your_name>

# --- Reference: Snowsight account details (not read by the code) ---
# Account identifier ........ GWEPWIG-CA86069
# Organization / account .... GWEPWIG / CA86069
# Account/Server URL ........ GWEPWIG-CA86069.snowflakecomputing.com
# Cloud / edition ........... AWS / Enterprise
# Admin login (Snowsight) ... GEORGEAPPEAH, role ACCOUNTADMIN: use only to run infra/snowflake_setup.sql

# --- Ember API (https://ember-energy.org/data/api/) ---
# Put the real key in .env (gitignored), never in this file.
EMBER_API_KEY=
